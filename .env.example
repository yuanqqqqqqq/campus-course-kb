# ============================================================================
# 校园课程知识库 RAG 问答系统 —— 环境变量样例
#
# 用法：
#   cp .env.example .env
# 然后把 .env 里的 DEEPSEEK_API_KEY 换成你自己的 Key。
#
# 注意：.env 已被 .gitignore 忽略，永远不要把真实 Key 提交到 Git。
# ============================================================================

# --- DeepSeek LLM（OpenAI 兼容接口）-----------------------------------------
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Embedding --------------------------------------------------------------
# local  = 本地 HuggingFace 模型（默认，无需额外 API 额度）
# openai = 任意 OpenAI 兼容的 Embedding 接口，需同时填下面两项
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 仅当 EMBEDDING_PROVIDER=openai 时才需要（local 模式请保持注释）
# EMBEDDING_API_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=your_embedding_api_key_here

# 可选：显式声明向量维度；留空则由模型自身决定
# EMBEDDING_DIMENSION=512

# 可选：国内直连 HuggingFace 容易失败，设成镜像可显著提速（uncomment 即生效）
# HF_ENDPOINT=https://hf-mirror.com

# --- 向量库 -----------------------------------------------------------------
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=campus_courses

# --- FAQ 数据 ---------------------------------------------------------------
FAQ_PATH=./data/faq.json
# 模糊匹配阈值：问题与 patterns 归一化（小写/去空白/去标点）后用
# difflib.SequenceMatcher 算相似度，达到该值才算命中；精确匹配不看这个值。
#
# 0.85 兜的是标点、语序与轻微改写，**兜不住错别字**：实测
# "CS202的考核方式是什么" 对 "CS201的考核方式是什么" 的相似度是 0.92，照样命中。
# 所以 patterns 要写成完整问句并带上课程编号。
FAQ_MATCH_THRESHOLD=0.85

# FAQ 写入令牌。默认留空 = POST /api/faq 不校验（演示/本地开发）。
# 一旦对公网或多用户开放就必须设置：不设令牌时，任何能访问服务的人都能往 FAQ 里写
# 任意文本，并被原样返回给之后所有问同类问题的用户。设置后调用方需带请求头
# X-Admin-Token，否则返回 401。未设置时启动日志会给出 WARNING。
FAQ_ADMIN_TOKEN=

# --- 意图路由 ---------------------------------------------------------------
# 规则短路所需的最低置信度。只有 FAQ 类规则允许短路——判定 FAQ 只是"该去查
# FAQ 库"，真正的命中由 FAQCache 决定，查不到会继续走 RAG。
# course_query / process_query / chitchat 的关键词命中只作为候选，仍会调用 LLM。
INTENT_RULE_THRESHOLD=0.90

# --- 检索与拒答 -------------------------------------------------------------
TOP_K=5
# 作用在"统一归一化后的 relevance_score"（余弦相似度，[0,1]，越大越相关）上。
# 低于该值：未开启 LLM 复核时直接拒答；开启时交给复核再决定。
#
# 0.50 是在本项目语料上用 bge-small-zh-v1.5 实测标定的结果：
#   10 条相关问题 top1 分数 0.573~0.767；8 条无关问题 0.261~0.480。
# 换成别的 Embedding 模型后必须重新标定，不要照搬。
RELEVANCE_THRESHOLD=0.50

# 向量分数不达标时，是否额外调用一次 LLM 复核相关性（默认关闭）。
# 关闭时：向量分数达标直接放行，不达标直接拒答，全程零额外 LLM 调用。
ENABLE_LLM_RELEVANCE_CHECK=false

# --- 应用元信息 -------------------------------------------------------------
APP_NAME=Campus Course Knowledge Base
APP_ENV=development

# --- LLM 与日志 -------------------------------------------------------------
LLM_TIMEOUT=30
# 调用失败后的最大重试次数（不含首次，默认 2 即最多尝试 3 次）。设 0 表示不重试。
# 只重试"可能自愈"的失败：超时、连接中断、限流、5xx、空回答。
# 鉴权失败 / 模型名不存在不重试——重试多少次都是同样的结果。
LLM_MAX_RETRIES=2
LOG_LEVEL=INFO
# 是否把用户问题原文写进日志（默认关闭，只记长度）。
# 日志会被采集、转发、长期留存，用户问了什么属于用户内容，不该默认入库。
LOG_REQUEST_CONTENT=false

# --- 性能测试（阶段 8，scripts/benchmark.py）--------------------------------
# 是否在压测里真的调用 DeepSeek。默认 false：用假 LLM，避免把压测变成烧钱。
ENABLE_REAL_LLM_BENCHMARK=false

# --- 评测（阶段 7，scripts/evaluate.py）-------------------------------------
# 评测时是否真的调用 DeepSeek。默认 false：规则分类 + 假生成层，零 API 成本，
# 代价是"LLM 分类"与"LLM 写作"不进入度量（报告里会标注）。
ENABLE_REAL_LLM_EVAL=false
# 是否启用 LLM Judge 指标（faithfulness）。默认关闭：每条多一次调用，成本翻倍。
ENABLE_LLM_EVALUATION=false

# --- CORS -------------------------------------------------------------------
# 逗号分隔；填 * 表示允许所有来源（仅建议本地开发使用）
CORS_ORIGINS=http://localhost:3000
